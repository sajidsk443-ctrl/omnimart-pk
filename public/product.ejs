<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0b1220">
  <title><%= product.name || product.title || 'Product' %> | OmniMart PK</title>
  <meta name="description" content="<%= String(product.description || 'Shop OmniMart PK with Cash on Delivery across Pakistan.').slice(0,155) %>">
  <style>
    :root[data-theme=dark]{--bg:#0b1220;--panel:#121d2d;--panel2:#172438;--text:#edf4fb;--muted:#9bacc0;--line:#28384d;--accent:#43d5bb;--overlay:#030914df;--shadow:0 18px 54px #0005;--danger:#ff7e86}
    :root[data-theme=light]{--bg:#f5f7fb;--panel:#fff;--panel2:#f9fbff;--text:#142033;--muted:#65758b;--line:#e3e9f1;--accent:#078b7b;--overlay:#07101d99;--shadow:0 16px 48px #10233c15;--danger:#d64b55}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}body.locked{overflow:hidden}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button{cursor:pointer}.topline{background:linear-gradient(90deg,#0a776f,#16b7a0);color:#fff;text-align:center;padding:8px;font-size:12px;font-weight:700}.header{position:sticky;top:0;z-index:20;background:var(--panel);border-bottom:1px solid var(--line)}.nav{width:min(1160px,calc(100% - 32px));height:64px;margin:auto;display:flex;align-items:center;gap:12px}.brand{display:flex;align-items:center;gap:9px;font-weight:850}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#16b7a0,#2274c8);color:white}.nav-right{margin-left:auto;display:flex;align-items:center;gap:8px}.nav-button,.theme-select{border:1px solid var(--line);border-radius:10px;padding:8px 11px;background:var(--panel2);color:var(--text);font-size:13px;font-weight:700}.count{display:inline-grid;place-items:center;min-width:18px;height:18px;padding:0 4px;border-radius:20px;background:var(--accent);color:#03231e;font-size:11px}.wrap{width:min(1120px,calc(100% - 32px));margin:28px auto 90px}.crumb{color:var(--muted);font-size:12px;margin-bottom:15px}.product{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(22px,4vw,52px);padding:clamp(14px,3vw,32px);border:1px solid var(--line);border-radius:20px;background:var(--panel);box-shadow:var(--shadow)}.gallery{min-width:0}.stage{display:grid;place-items:center;overflow:hidden;aspect-ratio:1;border:1px solid var(--line);border-radius:16px;background:var(--panel2)}.stage img,.stage video{width:100%;height:100%;max-height:620px;object-fit:contain}.stage video{background:#05080d}.thumbs{display:flex;gap:8px;overflow:auto;margin-top:10px}.thumb{flex:0 0 66px;width:66px;height:66px;padding:0;overflow:hidden;border:2px solid transparent;border-radius:10px;background:var(--panel2)}.thumb.active{border-color:var(--accent)}.thumb img,.thumb video{width:100%;height:100%;object-fit:cover}.info{padding:6px 0}.eyebrow{color:var(--accent);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.12em}.info h1{margin:7px 0 10px;font-size:clamp(25px,3.5vw,39px);line-height:1.17;letter-spacing:-.04em}.rating{display:flex;gap:8px;color:var(--muted);font-size:13px}.stars{color:#ffb547;letter-spacing:1px}.price{margin:15px 0;color:var(--accent);font-size:clamp(28px,4vw,38px);font-weight:850}.desc{color:var(--muted);white-space:pre-line;margin:10px 0 18px}.stock{color:var(--accent);font-size:12px;font-weight:700;margin-bottom:13px}.buy{width:100%;min-height:50px;border:0;border-radius:12px;background:linear-gradient(100deg,#14b89e,#0c9b8a);color:#03231e;font-weight:850;font-size:15px;box-shadow:0 9px 25px #15b99d33}.secondary-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}.secondary{min-height:42px;border:1px solid var(--line);border-radius:10px;background:var(--panel2);color:var(--text);font-weight:700}.trust{display:flex;justify-content:space-between;gap:9px;margin-top:19px;padding-top:15px;border-top:1px solid var(--line);color:var(--muted);font-size:11px}.trust b{display:block;color:var(--text);font-size:12px}.section{margin-top:42px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:13px}.section h2{margin:0;font-size:22px}.reviews{display:grid;grid-template-columns:.75fr 1.25fr;gap:16px}.review-form,.review-list{padding:17px;border:1px solid var(--line);border-radius:15px;background:var(--panel)}.field{margin-bottom:12px}.field label{display:block;margin-bottom:5px;font-size:12px;font-weight:750}.field input,.field textarea{width:100%;padding:10px 11px;border:1px solid var(--line);border-radius:9px;background:var(--panel2);color:var(--text)}.field textarea{min-height:85px;resize:vertical}.rating-input{display:flex;gap:4px}.rating-input button{border:0;background:none;color:#65758b;font-size:26px;padding:0 2px}.rating-input button.selected{color:#ffb547}.review-item{padding:12px 0;border-bottom:1px solid var(--line)}.review-item:last-child{border:0}.review-top{display:flex;justify-content:space-between;gap:8px;font-size:13px}.review-item p{margin:5px 0 0;color:var(--muted);font-size:13px;white-space:pre-line}.related-track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(185px,1fr);gap:12px;overflow:auto;scroll-snap-type:x mandatory;padding:2px 2px 10px}.related-card{overflow:hidden;scroll-snap-align:start;border:1px solid var(--line);border-radius:14px;background:var(--panel)}.related-card:hover{border-color:var(--accent)}.related-card img{width:100%;height:165px;object-fit:cover;background:var(--panel2)}.related-body{padding:11px}.related-body h3{margin:0 0 5px;font-size:13px}.related-price{color:var(--accent);font-weight:800}.controls{display:flex;gap:6px}.control{width:33px;height:33px;border:1px solid var(--line);border-radius:50%;background:var(--panel);color:var(--text)}.footer{padding:24px;text-align:center;color:var(--muted);font-size:12px;border-top:1px solid var(--line)}
    .checkout{position:fixed;inset:0;z-index:99999;display:none;align-items:center;justify-content:center;padding:14px;background:var(--overlay);backdrop-filter:blur(8px)}.checkout.open{display:flex}.checkout-box{position:relative;width:min(100%,470px);max-height:92vh;overflow:auto;padding:21px;border:1px solid var(--line);border-radius:18px;background:var(--panel);box-shadow:0 30px 100px #0009}.checkout-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.checkout-head h2{margin:0}.close{width:35px;height:35px;border:1px solid var(--line);border-radius:9px;background:var(--panel2);color:var(--text);font-size:20px}.summary{padding:10px;margin-bottom:12px;border-radius:10px;background:var(--panel2);font-size:13px}.error{min-height:18px;color:var(--danger);font-size:12px}.drawer-bg{position:fixed;inset:0;z-index:4000;background:#02071188;opacity:0;visibility:hidden;transition:.25s}.drawer-bg.open{opacity:1;visibility:visible}.drawer{position:fixed;z-index:4001;top:0;right:0;width:min(430px,92vw);height:100dvh;padding:18px;background:var(--panel);border-left:1px solid var(--line);transform:translateX(105%);transition:transform .28s;display:flex;flex-direction:column}.drawer.open{transform:translateX(0)}.drawer-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:12px}.drawer-head h2{margin:0}.wish-list{flex:1;overflow:auto}.wish-row{display:grid;grid-template-columns:62px 1fr auto;align-items:center;gap:9px;padding:11px 0;border-bottom:1px solid var(--line)}.wish-row img{width:62px;height:62px;object-fit:cover;border-radius:8px}.wish-row h3{margin:0;font-size:13px}.wish-row small{color:var(--muted)}.tiny{display:block;padding:6px 7px;margin:3px 0;border:1px solid var(--line);border-radius:7px;background:var(--panel2);color:var(--text);font-size:11px;font-weight:700}.toast{position:fixed;z-index:100001;left:50%;bottom:22px;transform:translate(-50%,16px);opacity:0;pointer-events:none;padding:10px 15px;border-radius:24px;background:#142238;color:#fff;font-size:13px;font-weight:750;transition:.2s}.toast.show{opacity:1;transform:translate(-50%,0)}.chat-fab{position:fixed;right:16px;bottom:17px;z-index:30;width:52px;height:52px;border:0;border-radius:50%;background:var(--accent);font-size:22px;font-weight:800}.chat{position:fixed;right:16px;bottom:78px;z-index:35;width:min(350px,calc(100vw - 26px));height:400px;display:none;flex-direction:column;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:var(--panel);box-shadow:var(--shadow)}.chat.open{display:flex}.chat-head{display:flex;justify-content:space-between;padding:12px;border-bottom:1px solid var(--line)}.chat-log{flex:1;overflow:auto;padding:12px}.chat-msg{margin:7px 0;padding:9px;border-radius:10px;background:var(--panel2);font-size:13px}.chat-msg.user{text-align:right}.chat-compose{display:flex;gap:6px;padding:9px;border-top:1px solid var(--line)}.chat-compose input{flex:1;min-width:0;padding:9px;border:1px solid var(--line);border-radius:8px;background:var(--panel2);color:var(--text)}.wa{margin:0 10px 10px;padding:9px;text-align:center;border-radius:8px;background:#087c61;color:white;font-weight:800;font-size:12px}.mobile-bar{position:fixed;z-index:25;left:0;right:0;bottom:0;display:none;align-items:center;gap:9px;padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:var(--panel);border-top:1px solid var(--line);box-shadow:0 -8px 25px #0002}.mobile-bar img{width:40px;height:40px;object-fit:cover;border-radius:8px}.mobile-price{flex:1;font-weight:850}.mobile-price small{display:block;color:var(--muted);font-size:10px}.mobile-bar .buy{width:auto;min-height:40px;padding:0 15px;font-size:13px}
    @media(max-width:740px){.nav{height:58px}.wrap{margin:17px auto 100px}.product{grid-template-columns:1fr;gap:14px;padding:12px}.stage{aspect-ratio:1}.info{padding:2px}.info h1{font-size:27px}.price{margin:10px 0}.reviews{grid-template-columns:1fr}.mobile-bar{display:flex}.chat-fab{bottom:74px;right:12px}.chat{bottom:135px;right:12px}.related-track{grid-auto-columns:minmax(155px,46vw)}.related-card img{height:140px}.brand{font-size:14px}.nav-button,.theme-select{padding:7px;font-size:11px}.trust{font-size:10px}}
  </style>
  <% if (typeof process !== 'undefined' && process.env && process.env.FB_PIXEL_ID) { %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','<%= process.env.FB_PIXEL_ID %>');fbq('track','PageView');</script><% } %>
  <% if (typeof process !== 'undefined' && process.env && process.env.TIKTOK_PIXEL_ID) { %>
  <script>!function(w,d,t){w.TiktokAnalyticsObject=t;var q=w[t]=w[t]||[];q.methods=['page','track','identify','instances','debug','on','off','once','ready','alias','group','enableCookie','disableCookie'];q.setAndDefer=function(a,b){a[b]=function(){a.push([b].concat([].slice.call(arguments)))}};for(var i=0;i<q.methods.length;i++)q.setAndDefer(q,q.methods[i]);q.load=function(id){var s=d.createElement('script');s.async=1;s.src='https://analytics.tiktok.com/i18n/pixel/events.js?sdkid='+id+'&lib='+t;d.getElementsByTagName('script')[0].parentNode.insertBefore(s,d.getElementsByTagName('script')[0])};q.load('<%= process.env.TIKTOK_PIXEL_ID %>');q.page()}(window,document,'ttq');</script><% } %>
</head>
<body>
  <div class="topline">Cash on Delivery available across Pakistan</div>
  <header class="header"><nav class="nav" aria-label="Main navigation"><a class="brand" href="/"><span class="brand-mark">O</span><span>OmniMart PK</span></a><div class="nav-right"><a class="nav-button" href="/">Shop</a><button class="nav-button" id="wishlistOpen" type="button">♡ Wishlist <span class="count" id="wishCount">0</span></button><select class="theme-select" id="themeSelect" aria-label="Theme"><option value="dark">Dark</option><option value="light">Light</option></select></div></nav></header>
  <main class="wrap"><div class="crumb"><a href="/">Home</a> / <%= product.category || 'Shop' %> / <%= product.name || product.title || 'Product' %></div>
    <section class="product"><div class="gallery"><div class="stage" id="stage"></div><div class="thumbs" id="thumbs" aria-label="Product media gallery"></div></div><div class="info"><div class="eyebrow"><%= product.category || 'OmniMart pick' %></div><h1 id="productTitle"><%= product.name || product.title || 'Product' %></h1><div class="rating"><span class="stars" id="stars">★★★★★</span><span id="ratingSummary">Loading reviews…</span></div><div class="price">PKR <%= Number(product.price || 0).toLocaleString('en-PK') %></div><p class="desc"><%= product.description || 'Quality product selected for everyday use. Order today and pay conveniently on delivery.' %></p><div class="stock"><%= Number(product.stock) > 0 ? '● In stock and ready to ship' : '● Available to order' %></div><button class="buy" id="buyNow" type="button">Buy Now · Cash on Delivery</button><div class="secondary-row"><button class="secondary" id="wishToggle" type="button">♡ Save to Wishlist</button><button class="secondary" id="chatOpen" type="button">Ask a question</button></div><div class="trust"><div><b>Cash on Delivery</b>Pay on arrival</div><div><b>Nationwide</b>Pakistan delivery</div><div><b>Support</b>We can help</div></div></div></section>
    <section class="section" id="reviewsSection"><div class="section-head"><div><div class="eyebrow">Customer experiences</div><h2>Reviews &amp; ratings</h2></div><span id="reviewCount" class="muted">0 reviews</span></div><div class="reviews"><form class="review-form" id="reviewForm"><h3 style="margin:0 0 10px">Write a review</h3><div class="field"><label>Your rating</label><div class="rating-input" id="ratingInput" role="radiogroup" aria-label="Rating"><button type="button" data-rate="1" aria-label="1 star">★</button><button type="button" data-rate="2" aria-label="2 stars">★</button><button type="button" data-rate="3" aria-label="3 stars">★</button><button type="button" data-rate="4" aria-label="4 stars">★</button><button type="button" data-rate="5" aria-label="5 stars">★</button></div></div><div class="field"><label for="reviewName">Name</label><input id="reviewName" maxlength="60" required></div><div class="field"><label for="reviewText">Review</label><textarea id="reviewText" maxlength="800" required></textarea></div><button class="nav-button">Post review</button><p class="muted" style="font-size:11px">Saved in this browser on this device.</p></form><div class="review-list" id="reviewList" aria-live="polite"></div></div></section>
    <section class="section"><div class="section-head"><div><div class="eyebrow">Picked for you</div><h2>You may also like</h2></div><div class="controls"><button class="control" id="prev" aria-label="Scroll left">‹</button><button class="control" id="next" aria-label="Scroll right">›</button></div></div><div class="related-track" id="relatedTrack">
      <% const catKey=String(product.category||'').trim().toLowerCase(); const relatedItems=Array.isArray(related)?related.filter(item=>String(item.category||'').trim().toLowerCase()===catKey&&String(item._id||item.id)!==String(product._id||product.id)):[]; %>
      <% relatedItems.forEach(function(item){const m=Array.isArray(item.mediaFiles)&&item.mediaFiles.length?item.mediaFiles[0]:null;const image=m?(m.path||m.url||''):(item.imageUrl||(Array.isArray(item.media)?item.media[0]:'')); %><a class="related-card" href="/product/<%= item._id||item.id %>"><img src="<%= image||'https://placehold.co/420x360?text=OmniMart' %>" loading="lazy" alt="<%= item.name||item.title||'Product' %>"><div class="related-body"><h3><%= item.name||item.title||'Product' %></h3><span class="related-price">PKR <%= Number(item.price||0).toLocaleString('en-PK') %></span></div></a><% }); %>
      <% if(!relatedItems.length){ %><p class="muted">More products in this category are coming soon.</p><% } %>
    </div></section>
  </main><footer class="footer">OmniMart PK · Cash on Delivery across Pakistan</footer>
  <div class="mobile-bar" id="mobileBar"><img id="mobileThumb" alt=""><div class="mobile-price"><small>Buy this item</small>PKR <%= Number(product.price||0).toLocaleString('en-PK') %></div><button class="buy" id="mobileBuy" type="button">Buy Now</button></div>
  <div class="drawer-bg" id="drawerBg"></div><aside class="drawer" id="drawer" aria-hidden="true"><div class="drawer-head"><h2>♡ Your Wishlist</h2><button class="close" id="wishClose" aria-label="Close wishlist">×</button></div><div class="wish-list" id="wishList"></div></aside>
  <div class="checkout" id="checkout" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="checkoutTitle"><div class="checkout-box"><div class="checkout-head"><div><div class="eyebrow">Secure checkout</div><h2 id="checkoutTitle">Cash on Delivery</h2></div><button class="close" id="checkoutClose" aria-label="Close">×</button></div><div class="summary" id="summary"></div><form id="orderForm"><div class="field"><label for="customerName">Full name</label><input id="customerName" required maxlength="100" autocomplete="name"></div><div class="field"><label for="customerPhone">Phone number</label><input id="customerPhone" type="tel" required maxlength="25" autocomplete="tel" placeholder="03xx xxxxxxx"></div><div class="field"><label for="customerCity">City</label><input id="customerCity" required maxlength="80" autocomplete="address-level2"></div><div class="field"><label for="customerAddress">Delivery address</label><textarea id="customerAddress" required maxlength="500" autocomplete="street-address"></textarea></div><div class="field"><label for="quantity">Quantity</label><input id="quantity" type="number" min="1" max="<%= Math.max(1,Number(product.stock)||99) %>" value="1" required></div><p class="error" id="orderMessage" role="status"></p><button class="buy" id="submitOrder">Place COD order</button></form></div></div>
  <div class="chat" id="chat" aria-hidden="true"><div class="chat-head"><strong>OmniMart Support</strong><button class="close" id="chatClose" aria-label="Close chat">×</button></div><div class="chat-log" id="chatLog" aria-live="polite"><div class="chat-msg">Hello! Ask about delivery, COD, returns, or this product. For a person, use WhatsApp below.</div></div><form class="chat-compose" id="chatForm"><input id="chatInput" maxlength="400" aria-label="Message support" placeholder="Type a question"><button class="nav-button">Send</button></form><a class="wa" href="https://wa.me/923144039790?text=Hello%20OmniMart%20support" target="_blank" rel="noopener noreferrer">Chat with support on WhatsApp</a></div><button class="chat-fab" id="chatFab" type="button" aria-label="Open support chat">✦</button><div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
  (()=>{'use strict';
    const product=<%- JSON.stringify({id:String(product._id||product.id||''),name:product.name||product.title||'Product',category:product.category||'',price:Number(product.price||0),imageUrl:product.imageUrl||product.image||'',mediaFiles:Array.isArray(product.mediaFiles)?product.mediaFiles:[],media:Array.isArray(product.media)?product.media:[]}).replace(/</g,'\\u003c') %>;
    const $=id=>document.getElementById(id), money=v=>new Intl.NumberFormat('en-PK').format(Number(v)||0);const read=(k,d)=>{try{return JSON.parse(localStorage.getItem(k)||'null')??d}catch(_){return d}},write=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch(_){}};
    const media=[];(Array.isArray(product.mediaFiles)?product.mediaFiles:[]).forEach(x=>{const url=typeof x==='string'?x:(x.path||x.url||'');if(url)media.push({url,kind:x.mediaType==='video'||String(x.mimeType||'').startsWith('video/')||/\.(mp4|mov|avi|webm)(\?|$)/i.test(url)?'video':'image',mime:x.mimeType||''})});if(!media.length&&Array.isArray(product.media))product.media.forEach(url=>{if(url)media.push({url,kind:/\.(mp4|mov|avi|webm)(\?|$)/i.test(String(url))?'video':'image'})});if(!media.length&&product.imageUrl)media.push({url:product.imageUrl,kind:'image'});
    function showMedia(item,button){const stage=$('stage');stage.replaceChildren();const n=document.createElement(item.kind==='video'?'video':'img');n.src=item.url;if(item.kind==='video'){n.controls=true;n.playsInline=true;n.preload='metadata';if(item.mime)n.type=item.mime}else{n.alt=product.name;n.fetchPriority='high'}stage.append(n);document.querySelectorAll('.thumb').forEach(t=>t.classList.toggle('active',t===button))}
    media.forEach((item,i)=>{const b=document.createElement('button');b.type='button';b.className='thumb';b.setAttribute('aria-label','Show product media '+(i+1));const n=document.createElement(item.kind==='video'?'video':'img');n.src=item.url;if(item.kind==='video'){n.muted=true;n.playsInline=true;n.preload='metadata'}else n.alt='';b.append(n);b.onclick=()=>showMedia(item,b);$('thumbs').append(b);if(!i)showMedia(item,b)});if(!media.length){const p=document.createElement('p');p.className='muted';p.textContent='Product images will appear here.';$('stage').append(p)}$('mobileThumb').src=media.find(x=>x.kind==='image')?.url||product.imageUrl||'https://placehold.co/100x100?text=OM';
    const fbId='<%= typeof process !== "undefined" && process.env ? (process.env.FB_PIXEL_ID||"") : "" %>',ttId='<%= typeof process !== "undefined" && process.env ? (process.env.TIKTOK_PIXEL_ID||"") : "" %>';
    function track(name,values={}){try{if(fbId&&window.fbq)window.fbq('track',name,values);if(ttId&&window.ttq&&window.ttq.track)window.ttq.track(name==='Purchase'?'CompletePayment':name,{content_id:product.id,content_name:product.name,value:Number(values.value||product.price),currency:'PKR'})}catch(_){}}track('ViewContent',{content_ids:[product.id],content_name:product.name,content_type:'product',value:product.price,currency:'PKR'});
    function toast(text){const el=$('toast');el.textContent=text;el.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove('show'),2200)}
    function openCheckout(){ $('summary').textContent=product.name+' · PKR '+money(product.price)+' · Cash on Delivery';$('orderMessage').textContent='';$('checkout').classList.add('open');$('checkout').setAttribute('aria-hidden','false');document.body.classList.add('locked');setTimeout(()=>$('customerName').focus(),20)}function closeCheckout(){$('checkout').classList.remove('open');$('checkout').setAttribute('aria-hidden','true');document.body.classList.remove('locked')}$('buyNow').onclick=openCheckout;$('mobileBuy').onclick=openCheckout;$('checkoutClose').onclick=closeCheckout;$('checkout').onclick=e=>{if(e.target===$('checkout'))closeCheckout()};
    $('orderForm').onsubmit=async e=>{e.preventDefault();const quantity=Number($('quantity').value);if(!Number.isInteger(quantity)||quantity<1)return;$('submitOrder').disabled=true;$('orderMessage').textContent='Submitting order…';const order={productId:product.id,productName:product.name,quantity,unitPrice:product.price,total:product.price*quantity,paymentMethod:'COD',customer:{name:$('customerName').value.trim(),phone:$('customerPhone').value.trim(),city:$('customerCity').value.trim(),address:$('customerAddress').value.trim()}};try{const r=await fetch('/api/orders',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify(order)});const d=await r.json().catch(()=>({}));if(!r.ok)throw Error(d.message||'Could not submit. Please contact us on WhatsApp.');track('Purchase',{value:order.total,currency:'PKR'});$('orderMessage').style.color='var(--accent)';$('orderMessage').textContent=d.message||'Order received! OmniMart will contact you to confirm.';setTimeout(closeCheckout,1800)}catch(err){$('orderMessage').style.color='var(--danger)';$('orderMessage').textContent=err.message}finally{$('submitOrder').disabled=false}};
    let wish=read('omniWishlist',[]);if(!Array.isArray(wish))wish=[];const isSaved=()=>wish.some(x=>String(x.id||x._id)===product.id);function paintWish(){ $('wishCount').textContent=wish.length;$('wishToggle').textContent=isSaved()?'♥ Saved to Wishlist':'♡ Save to Wishlist'}
    function renderWish(){const list=$('wishList');list.replaceChildren();if(!wish.length){const p=document.createElement('p');p.className='muted';p.textContent='Your wishlist is empty.';list.append(p);return}wish.forEach(item=>{const row=document.createElement('div');row.className='wish-row';const img=document.createElement('img');img.src=item.image||'https://placehold.co/100x100?text=OM';img.alt='';const detail=document.createElement('div');const h=document.createElement('h3');h.textContent=item.name||'Product';const price=document.createElement('small');price.textContent='PKR '+money(item.price);detail.append(h,price);const actions=document.createElement('div');const add=document.createElement('button');add.className='tiny';add.textContent='Add to Cart';add.onclick=()=>{const cart=read('omniCart',[]);cart.push({id:item.id,name:item.name,price:item.price,quantity:1});write('omniCart',cart);track('AddToCart',{value:item.price,currency:'PKR'});toast('Added to Cart');openCheckout()};const remove=document.createElement('button');remove.className='tiny';remove.textContent='Remove';remove.onclick=()=>toggleWish(item);actions.append(add,remove);row.append(img,detail,actions);list.append(row)})}
    function toggleWish(item=product){const id=String(item.id||item._id||'');const i=wish.findIndex(x=>String(x.id||x._id)===id);if(i>=0){wish.splice(i,1);toast('Removed from Wishlist')}else{wish.push({id,name:item.name||item.title||'Product',price:Number(item.price)||0,image:item.image||item.imageUrl||'',url:item.url||('/product/'+encodeURIComponent(id))});toast('Added to Wishlist!')}write('omniWishlist',wish);paintWish();renderWish()}
    function drawer(open){$('drawer').classList.toggle('open',open);$('drawer').setAttribute('aria-hidden',String(!open));$('drawerBg').classList.toggle('open',open);document.body.classList.toggle('locked',open)}$('wishToggle').onclick=()=>toggleWish();$('wishlistOpen').onclick=()=>drawer(true);$('wishClose').onclick=()=>drawer(false);$('drawerBg').onclick=()=>drawer(false);paintWish();renderWish();
    let rating=0,reviews=read('omniReviews:'+product.id,[]);if(!Array.isArray(reviews))reviews=[];function drawReviews(){const list=$('reviewList');list.replaceChildren();const avg=reviews.length?reviews.reduce((a,x)=>a+Number(x.rating),0)/reviews.length:0;$('reviewCount').textContent=reviews.length+' review'+(reviews.length===1?'':'s');$('ratingSummary').textContent=reviews.length?avg.toFixed(1)+' · '+reviews.length+' reviews':'No reviews yet';$('stars').textContent='★'.repeat(Math.round(avg))+'☆'.repeat(5-Math.round(avg));if(!reviews.length){const p=document.createElement('p');p.className='muted';p.textContent='Be the first to review this product.';list.append(p)}[...reviews].reverse().forEach(x=>{const item=document.createElement('article');item.className='review-item';const top=document.createElement('div');top.className='review-top';const name=document.createElement('strong');name.textContent=x.name;const stars=document.createElement('span');stars.className='stars';stars.textContent='★'.repeat(x.rating)+'☆'.repeat(5-x.rating);const text=document.createElement('p');text.textContent=x.text;top.append(name,stars);item.append(top,text);list.append(item)})}document.querySelectorAll('[data-rate]').forEach(b=>b.onclick=()=>{rating=Number(b.dataset.rate);document.querySelectorAll('[data-rate]').forEach(s=>s.classList.toggle('selected',Number(s.dataset.rate)<=rating))});$('reviewForm').onsubmit=e=>{e.preventDefault();if(!rating){toast('Choose a star rating first');return}reviews.push({name:$('reviewName').value.trim(),rating,text:$('reviewText').value.trim()});write('omniReviews:'+product.id,reviews);e.target.reset();rating=0;document.querySelectorAll('[data-rate]').forEach(s=>s.classList.remove('selected'));drawReviews();toast('Thanks for sharing your review!')};drawReviews();
    $('prev').onclick=()=>$('relatedTrack').scrollBy({left:-250,behavior:'smooth'});$('next').onclick=()=>$('relatedTrack').scrollBy({left:250,behavior:'smooth'});
    // Refresh recommendations from the public catalog so the carousel can select the same category.
    fetch('/api/catalog/products',{headers:{Accept:'application/json'}}).then(r=>r.ok?r.json():null).then(payload=>{const all=Array.isArray(payload)?payload:payload&&payload.products;if(!Array.isArray(all))return;const matches=all.filter(x=>String(x.category||'').trim().toLowerCase()===String(product.category||'').trim().toLowerCase()&&String(x._id||x.id)!==product.id);if(!matches.length)return;const trackEl=$('relatedTrack');trackEl.replaceChildren();matches.slice(0,12).forEach(item=>{const mediaItem=Array.isArray(item.mediaFiles)&&item.mediaFiles.length?item.mediaFiles[0]:null;const image=mediaItem?(mediaItem.path||mediaItem.url||''):(item.imageUrl||(Array.isArray(item.media)?item.media[0]:''));const link=document.createElement('a');link.className='related-card';link.href='/product/'+encodeURIComponent(item._id||item.id);const img=document.createElement('img');img.src=image||'https://placehold.co/420x360?text=OmniMart';img.alt=item.name||item.title||'Product';img.loading='lazy';const body=document.createElement('div');body.className='related-body';const title=document.createElement('h3');title.textContent=item.name||item.title||'Product';const price=document.createElement('span');price.className='related-price';price.textContent='PKR '+money(item.price);body.append(title,price);link.append(img,body);trackEl.append(link)})}).catch(()=>{});
    const theme=read('omnimart_theme','dark')==='light'?'light':'dark';document.documentElement.dataset.theme=theme;$('themeSelect').value=theme;$('themeSelect').onchange=e=>{document.documentElement.dataset.theme=e.target.value;write('omnimart_theme',e.target.value)};
    function chat(open){$('chat').classList.toggle('open',open);$('chat').setAttribute('aria-hidden',String(!open));if(open)setTimeout(()=>$('chatInput').focus(),20)}$('chatFab').onclick=()=>chat(!$('chat').classList.contains('open'));$('chatOpen').onclick=()=>chat(true);$('chatClose').onclick=()=>chat(false);$('chatForm').onsubmit=e=>{e.preventDefault();const value=$('chatInput').value.trim();if(!value)return;const user=document.createElement('div');user.className='chat-msg user';user.textContent=value;$('chatLog').append(user);$('chatInput').value='';const reply=document.createElement('div');reply.className='chat-msg';const q=value.toLowerCase();reply.textContent=/delivery|ship/.test(q)?'We deliver across Pakistan. Our team confirms timing after you place your order.':/cod|cash/.test(q)?'Cash on Delivery is available. Use Buy Now to submit your delivery details.':/return|refund/.test(q)?'For return help, please contact support on WhatsApp with your order details.':'Thanks! Our support team can help on WhatsApp using the button below.';setTimeout(()=>$('chatLog').append(reply),200)};
    document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeCheckout();drawer(false);chat(false)}});if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{$('mobileBar').style.transform=entries[0].isIntersecting?'translateY(110%)':'translateY(0)';$('mobileBar').style.transition='transform .2s'});observer.observe($('buyNow'))}
  })();
  </script>
</body>
